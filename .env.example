POSTGRES_DB_NAME=livechat
POSTGRES_USER_NAME=livechat
POSTGRES_PASS_WORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Obrigatório somente para compose.prod.yaml. Use a URL fornecida pelo Redis Cloud.
REDIS_URL=rediss://default:troque-por-uma-senha@redis.example.com:16379

# Obrigatórios em produção. No LiveKit Cloud, copie a Project URL e crie uma chave em API keys.
# CLIENT_URL usa a Project URL (wss://); API_URL usa o mesmo host com https://.
LIVEKIT_API_URL=https://seu-projeto.livekit.cloud
LIVEKIT_CLIENT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=troque-esta-chave
LIVEKIT_API_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Configuração opcional do LiveKit.
LIVEKIT_TOKEN_TTL=5m
LIVEKIT_ROOM_EMPTY_TIMEOUT=5m
LIVEKIT_ROOM_PROVISIONING_ENABLED=true

# Valores adequados para desenvolvimento local.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
POSTGRES_PORT=5432
APP_VERSION=latest
